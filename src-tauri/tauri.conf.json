{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ScanTailor Next",
  "mainBinaryName": "scantailor-next",
  "version": "0.2.0",
  "identifier": "com.scantailor.next",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1430",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ScanTailor Next — Book & Document Post-Processing Studio",
        "width": 1360,
        "height": 860,
        "minWidth": 1024,
        "minHeight": 680,
        "decorations": true,
        "center": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
